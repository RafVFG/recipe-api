# Banco de dados
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=recipes

# Servidor
HOST=localhost
PORT=3000

# URL base da aplicação (usada no link do magic link)
APP_URL=http://localhost:3000

# JWT
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# SMTP (Email)
# Para Gmail: ative 2FA e gere uma App Password em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
